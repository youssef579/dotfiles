snippet !spf
  const int N = ;
  int spf[N];

  void SPF() {
    iota(spf, spf + N, 0);

    for (ll i = 2; i < N; i++) {
      if (spf[i] == i) {
        for (ll j = i * i; j < N; j += i)
          spf[j] = min(spf[j], i);
      }
    }
  }
snippet !sieve
  const int N = ;
  bool isPrime[N];

  void Sieve() {
    memset(isPrime, 1, sizeof isPrime);
    isPrime[0] = isPrime[1] = false;

    for (ll i = 2; i < N; i++) {
      if (isPrime[i]) {
        for (ll j = i * i; j < N; j += i) {
          isPrime[j] = false;
        }
      }
    }
  }
snippet !mod_arithmetics
  ll MOD = ;

  ll add(ll a, ll b) { return (a % MOD + b % MOD) % MOD; }

  ll sub(ll a, ll b) { return (a % MOD - b % MOD + MOD) % MOD; }

  ll mult(ll a, ll b) { return ((a % MOD) * (b % MOD)) % MOD; }

  ll fp(ll base, ll power) {
    if (power == 0)
      return 1;

    ll hp = fp(base, power / 2);
    ll fullPower = mult(hp, hp);

    if (power % 2)
      fullPower = mult(fullPower, base);

    return fullPower;
  }

  ll divi(ll a, ll b) { return mult(a, fp(b, MOD - 2)); }
snippet !combinatorics
  const int N = ;
  int fact[N], invFact[N];

  ll nPr(ll n, ll r) {
    return r > n || n < 0 || r < 0 ? 0 : mult(fact[n], invFact[n - r]);
  }

  ll nCr(ll n, ll r) {
    return r > n || n < 0 || r < 0
               ? 0
               : mult(fact[n], mult(invFact[r], invFact[n - r]));
  }

  ll sNb(ll n, ll k) { return nCr(n + k - 1, n); }

  void precalFactorial() {
    fact[0] = 1;
    for (int i = 1; i < N; i++)
      fact[i] = mult(fact[i - 1], i);

    invFact[N - 1] = divi(1, fact[N - 1]);
    for (int i = N - 2; i >= 0; i--)
      invFact[i] = mult(invFact[i + 1], i + 1);
  }
