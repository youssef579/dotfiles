snippet !spf
  const int N = 1e6 + 1;
  array<int, N> spf;

  void SPF() {
    for (int i = 2; i < N; i++) {
      if (spf[i] == 0) {
        spf[i] = i;
        for (ll j = 1ll * i * i; j < N; j += i)
          if (!spf[j])
            spf[j] = i;
      }
    }
  }
snippet !sieve
  const int N = 1e6 + 1;
  array<bool, N> isPrime;

  void Sieve() {
    isPrime.fill(true);
    isPrime[0] = isPrime[1] = false;

    for (int i = 2; i < N; i++) {
      if (isPrime[i]) {
        for (ll j = 1ll * i * i; j < N; j += i)
          isPrime[j] = false;
      }
    }
  }
snippet !mod_arithmetics
  ll MOD = 1e9 + 7;

  ll add(ll a, ll b, ll mod = MOD) { return (a % mod + b % mod) % mod; }

  ll sub(ll a, ll b, ll mod = MOD) { return (a % mod - b % mod + mod) % mod; }

  ll mult(ll a, ll b, ll mod = MOD) { return ((a % mod) * (b % mod)) % mod; }

  ll fp(ll base, ll power, ll mod = MOD) {
    if (power == 0)
      return 1;

    ll hp = fp(base, power / 2, mod);
    ll fullPower = mult(hp, hp, mod);

    if (power % 2 != 0)
      fullPower = mult(fullPower, base, mod);

    return fullPower;
  }

  ll divi(ll a, ll b, ll mod = MOD) { return mult(a, fp(b, mod - 2)); }
snippet !combinatorics
  const int N = 1e6 + 1;
  array<int, N> fact, invFact;

  ll nPr(ll n, ll r, ll mod = MOD) {
    return r > n || n < 0 || r < 0 ? 0 : mult(fact[n], invFact[n - r], mod);
  }

  ll nCr(ll n, ll r, ll mod = MOD) {
    return r > n || n < 0 || r < 0
               ? 0
               : mult(fact[n], mult(invFact[r], invFact[n - r], mod), mod);
  }

  ll sNb(ll n, ll k, ll mod = MOD) { return nCr(n + k - 1, n, mod); }

  void precalFactorial(ll mod = MOD) {
    fact[0] = 1;
    for (int i = 1; i < N; i++)
      fact[i] = mult(fact[i - 1], i, mod);

    invFact[N - 1] = divi(1, fact[N - 1], mod);
    for (int i = N - 2; i > -1; i--)
      invFact[i] = mult(invFact[i + 1], i + 1, mod);
  }
