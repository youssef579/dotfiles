snippet !segment_lazy
  struct Node {
    ll lazy = -1;
    bool hasLazy = false;

    Node mergeData(Node &r) {
      Node ans;
      return ans;
    }

    void applyLazy(ll l, ll r) {
      hasLazy = false;
      lazy = -1;
    }

    void mergeLazy(Node &par) {
      hasLazy = true;
    }
  };

  struct LazySeg {
    int size;
    vector<Node> data;

    void build(int l, int r, int node, const vector<Node> &arr) {
      if (l == r) {
        if (l < len(arr))
          data[node] = arr[l];

        return;
      }

      build(l, (l + r) / 2, node * 2 + 1, arr);
      build((l + r) / 2 + 1, r, node * 2 + 2, arr);
      data[node] = data[node * 2 + 1].mergeData(data[node * 2 + 2]);
    }

    void update(int l, int r, int node, int lq, int rq, Node val) {
      propagate(l, r, node);
      if (l > rq || r < lq)
        return;

      if (l >= lq && r <= rq) {
        data[node].mergeLazy(val);
        propagate(l, r, node);
        return;
      }

      update(l, (l + r) / 2, node * 2 + 1, lq, rq, val);
      update((l + r) / 2 + 1, r, node * 2 + 2, lq, rq, val);
      data[node] = data[node * 2 + 1].mergeData(data[node * 2 + 2]);
    }

    void propagate(int l, int r, int node) {
      if (!data[node].hasLazy)
        return;

      if (l != r) {
        data[node * 2 + 1].mergeLazy(data[node]);
        data[node * 2 + 2].mergeLazy(data[node]);
      }

      data[node].applyLazy(l, r);
    }

    Node query(int l, int r, int node, int lq, int rq) {
      propagate(l, r, node);
      if (l > rq || r < lq)
        return Node();

      if (l >= lq && r <= rq)
        return data[node];

      Node left = query(l, (l + r) / 2, node * 2 + 1, lq, rq);
      Node right = query((l + r) / 2 + 1, r, node * 2 + 2, lq, rq);

      return left.mergeData(right);
    }

    LazySeg(const vector<Node> &arr) {
      for (size = 1; size < len(arr); size <<= 1);
      data.assign(size * 2, Node());

      build(0, size - 1, 0, arr);
    }

    void update(int l, int r, Node val) { update(0, size - 1, 0, l, r, val); }

    Node query(int l, int r) { return query(0, size - 1, 0, l, r); }
  };
snippet !sparse_table
  struct Node {};

  struct SparseTable {
    vector<vector<Node>> data;
    Node defaultValue;

    Node merge(Node a, Node b) { return a; }

    SparseTable() {}

    SparseTable(const vector<Node> &arr) {
      int n = len(arr), lg = __lg(n);
      data.assign(n, vector<Node>(lg + 1));

      for (int i = 0; i < n; i++)
        data[i][0] = arr[i];

      for (int i = 1; i <= lg; i++) {
        for (int j = 0; j + (1 << i) <= n; j++)
          data[j][i] = merge(data[j][i - 1], data[j + (1 << (i - 1))][i - 1]);
      }
    }

    Node query(int l, int r) {
      Node ans = defaultValue;
      int diff = r - l + 1, last = l;

      while (diff) {
        int top = __lg(diff);
        ans = merge(ans, data[last][top]);

        last += (1 << top);
        diff &= ~(1 << top);
      }

      return ans;
    }
  };
snippet !trie
  struct Node {
    array<Node *, 26> next{};
    int data = INT_MAX;
  };

  struct Trie {
    Node *root = new Node();

    void insert(string &s) {
      Node *cur = root;
      int n = len(s);

      for (int i = 0; i < n; i++) {
        if (!cur->next[s[i] - 'a'])
          cur->next[s[i] - 'a'] = new Node();

        cur = cur->next[s[i] - 'a'];
        cur->data = min(cur->data, n);
      }
    }

    int get(string &s) {
      Node *cur = root;

      for (int i = 0; i < len(s); i++) {
        if (!cur->next[s[i] - 'a'])
          return -1;

        cur = cur->next[s[i] - 'a'];
      }

      return cur->data;
    }
  };
snippet binary_trie
  struct Node {
    array<Node *, 2> next{};
  };

  struct Trie {
    Node *root = new Node();

    void insert(int s) {
      Node *cur = root;

      for (int i = 29; i >= 0; i--) {
        bool j = (s >> i) & 1;
        if (!cur->next[j])
          cur->next[j] = new Node();

        cur = cur->next[j];
      }
    }

    int get(int s) {
      Node *cur = root;

      int best{};
      for (int i = 29; i >= 0; i--) {
        bool j = (s >> i) & 1;
        if (cur->next[!j]) {
          cur = cur->next[!j];
          best = (best << 1) + !j;
        } else {
          cur = cur->next[j];
          best = (best << 1) + j;
        }
      }

      return best;
    }
  };
snippet !hashing
  struct Hash {
    static const int N = 2;
    vector<array<ll, N>> h, p;
    array<int, N> bases = {31, 37}, mods = {(int)1e9 + 7, (int)1e9 + 9};

    Hash(string &s) {
      int n = len(s);

      h.resize(n + 1);
      p.resize(n + 1);
      p[0].fill(1);

      for (int i = 1; i <= n; i++) {
        for (int j = 0; j < N; j++) {
          p[i][j] = (p[i - 1][j] * bases[j]) % mods[j];
          h[i][j] =
              ((h[i - 1][j] * bases[j]) % mods[j] + s[i - 1] - 'a' + 1) % mods[j];
        }
      }
    }

    array<ll, N> get(int l, int r) {
      l++, r++;
      array<ll, N> ans{};
      if (l <= r)
        for (int j = 0; j < N; j++)
          ans[j] =
              (h[r][j] - (h[l - 1][j] * p[r - l + 1][j]) % mods[j] + mods[j]) %
              mods[j];

      return ans;
    }
  };
snippet !dsu
  struct DSU {
    vector<int> par, sizes;

    DSU(int n) {
      sizes.assign(n + 1, 1);
      par.resize(n + 1);

      for (int i = 1; i <= n; i++)
        par[i] = i;
    }

    int find(int u) {
      if (par[u] == u)
        return u;

      return par[u] = find(par[u]);
    }

    bool merge(int u, int v) {
      int r1 = find(u), r2 = find(v);
      if (r1 == r2)
        return false;

      if (sizes[r1] > sizes[r2])
        swap(r1, r2);

      par[r1] = r2;
      sizes[r2] += sizes[r1];
      return true;
    }
  };
